{
    "name": "Gemini Alt Text Generator",
    "description": "画像を右クリックしてGemini AIでAltテキストを生成します。",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
      "contextMenus",
      "activeTab",
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "https://generativelanguage.googleapis.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "options_page": "options.html",
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
  