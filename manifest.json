{
    "name": "Gemini Alt Text Generator",
    "description": "画像右クリックまたはショートカット(Alt+A)からGemini AIでAltテキストを自動生成します。",
    "version": "1.1.0",
    "manifest_version": 3,
    "minimum_chrome_version": "123",
    "permissions": [
      "contextMenus",
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "https://generativelanguage.googleapis.com/*",
      "https://*/*",
      "http://*/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "options_page": "options.html",
    "action": {
      "default_title": "Gemini Alt Text Generator",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "commands": {
      "trigger_alt_generator": {
        "suggested_key": {
          "default": "Alt+A",
          "mac": "Alt+A"
        },
        "description": "フォーカス中の画像に対してAltテキスト生成を開始"
      }
    },
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
  